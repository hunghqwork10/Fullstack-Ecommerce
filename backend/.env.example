PORT=3000
# Connection string for PostgreSQL. Either set DATABASE_URL, or set the
# individual DB_* variables below; the pool prefers DATABASE_URL when present.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/fullstack_ecommerce
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fullstack_ecommerce
